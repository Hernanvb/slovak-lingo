<% include ../partials/header %>

  <body id="page-top" class="sidebar-toggled">

    <% include ../partials/navbar %>

    <div id="wrapper" class="bg-slovak">

      <% include ../partials/sidebar %>

      <div id="content-wrapper">

        <div class="container-fluid">

          <!-- Breadcrumbs-->
          <ol class="breadcrumb">
            <li class="breadcrumb-item">
              <a href="/users/<%= username %>/dashboard/">Dashboard</a>
            </li>
            <li class="breadcrumb-item active">Grammar</li>
          </ol>

          <!-- Icon Cards-->
          <div class="row">
            <% for (var i = 0; i < lessons.length; i++) { %>
                <div class="col-xl-3 col-sm-6 col-6 mb-3">
                  <div class="card text-white <%= bgColors[i%4] %> o-hidden h-100">
                    <div class="card-body">
                      <div class="card-body-icon">
                        <i class="fas fa-fw <%= lessons[i].icon %>"></i>
                      </div>
                      <div><%= lessons[i].title %></div>
                    </div>
                    <a class="card-footer text-white clearfix small z-1" href="/grammar/<%= username %>/<%= lessons[i].slug %>">
                      <span class="float-left">View Lesson</span>
                      <span class="float-right">
                        <i class="fas fa-angle-right"></i>
                      </span>
                    </a>
                  </div>
                </div>
            <% } %>
          </div>

          <!-- Grammar Quiz Section -->
          <div class="card mb-3 bg-slovak">
            <div class="card-header">
              <i class="fas fa-edit"></i>
              Start Grammar Quiz
            </div>
            <div class="card-body">
              <form method="POST" action="/grammar/<%= username %>/quiz">
                <div class="form-group">
                  <label for="numQuestions">Number of questions (max <%= totalQuestions %>):</label>
                  <input type="number" class="form-control" id="numQuestions" name="numQuestions" min="1" max="<%= totalQuestions %>" value="10">
                </div>
                <div class="form-group">
                  <label>Categories:</label>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="selectAll" checked>
                    <label class="form-check-label" for="selectAll"><strong>Select All</strong></label>
                  </div>
                  <hr class="my-2">
                  <% for (var i = 0; i < questionCategories.length; i++) { %>
                    <div class="form-check">
                      <input class="form-check-input grammar-cat-check" type="checkbox" name="categories" value="<%= questionCategories[i] %>" id="cat-<%= questionCategories[i] %>" checked>
                      <label class="form-check-label" for="cat-<%= questionCategories[i] %>"><%= categoryLabels[questionCategories[i]] %></label>
                    </div>
                  <% } %>
                </div>
                <button type="submit" class="btn btn-info btn-lg btn-block">Start Grammar Quiz</button>
              </form>
            </div>
          </div>

        </div>
        <!-- /.container-fluid -->

        <!-- Sticky Footer -->
        <footer class="sticky-footer">
          <div class="container my-auto">
            <div class="copyright text-center my-auto">
              <span>Copyright © Slovak Lingo 2018</span>
            </div>
          </div>
        </footer>

      </div>
      <!-- /.content-wrapper -->

    </div>
    <!-- /#wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
      <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <% include ../partials/logout-modal %>

    <!-- Start Test Modal-->
    <% include ../partials/start-modal %>

    <!-- Bootstrap core JavaScript-->
    <script src="https://code.jquery.com/jquery-3.3.1.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/js/bootstrap.bundle.min.js" integrity="sha384-pjaaA8dDz/5BgdFUPX6M/9SUZv4d12SUPF0axWc+VRZkx5xU3daN+lYb49+Ax+Tl" crossorigin="anonymous"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/javascripts/sb-admin.min.js"></script>

    <script>
      $(document).ready(function() {
        $('#selectAll').on('change', function() {
          $('.grammar-cat-check').prop('checked', this.checked);
        });
        $('.grammar-cat-check').on('change', function() {
          if (!this.checked) {
            $('#selectAll').prop('checked', false);
          } else if ($('.grammar-cat-check:checked').length === $('.grammar-cat-check').length) {
            $('#selectAll').prop('checked', true);
          }
        });
      });
    </script>

  </body>

</html>
