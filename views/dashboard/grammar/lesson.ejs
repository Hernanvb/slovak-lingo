<% include ../partials/header %>

  <body id="page-top" class="sidebar-toggled">

    <% include ../partials/navbar %>

    <div id="wrapper" class="bg-slovak">

      <% include ../partials/sidebar %>

      <div id="content-wrapper">

        <div class="container-fluid">

          <!-- Breadcrumbs-->
          <ol class="breadcrumb">
            <li class="breadcrumb-item">
              <a href="/users/<%= username %>/dashboard/">Dashboard</a>
            </li>
            <li class="breadcrumb-item">
              <a href="/grammar/<%= username %>">Grammar</a>
            </li>
            <li class="breadcrumb-item active"><%= lesson.title %></li>
          </ol>

          <!-- Lesson Content -->
          <div class="card mb-3 bg-info">
            <div class="card-header category-header">
              <i class="fas <%= lesson.icon %>"></i>
              <%= lesson.title %>
            </div>
            <div class="card-body">
              <p class="lead" style="color: #4b3636;"><%= lesson.explanation %></p>

              <% if (lesson.sections) { %>
                <% lesson.sections.forEach(function(section) { %>
                  <h4 class="mt-4 mb-3" style="color: #fff; border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom: 8px;">
                    <%= section.heading %>
                  </h4>

                  <% if (section.note) { %>
                    <p style="color: #463838; font-style: italic;"><%= section.note %></p>
                  <% } %>

                  <% if (section.tables) { %>
                    <% section.tables.forEach(function(table) { %>
                      <% if (table.subheading) { %>
                        <h5 class="mt-3 mb-2" style="color: #f9e79f;"><%= table.subheading %></h5>
                      <% } %>

                      <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered" style="color: #eee;">
                          <thead>
                            <tr style="background: rgba(0,0,0,0.2);">
                              <% table.headers.forEach(function(h) { %>
                                <th><%= h %></th>
                              <% }); %>
                            </tr>
                          </thead>
                          <tbody>
                            <% table.rows.forEach(function(row) { %>
                              <tr>
                                <% row.forEach(function(cell) { %>
                                  <td><%= cell %></td>
                                <% }); %>
                              </tr>
                            <% }); %>
                          </tbody>
                        </table>
                      </div>
                    <% }); %>
                  <% } %>
                <% }); %>
              <% } %>
            </div>
          </div>

        </div>
        <!-- /.container-fluid -->

        <!-- Sticky Footer -->
        <footer class="sticky-footer">
          <div class="container my-auto">
            <div class="copyright text-center my-auto">
              <span>Copyright © Slovak Lingo 2018</span>
            </div>
          </div>
        </footer>

      </div>
      <!-- /.content-wrapper -->

    </div>
    <!-- /#wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
      <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <% include ../partials/logout-modal %>

    <!-- Start Test Modal-->
    <% include ../partials/start-modal %>

    <!-- Bootstrap core JavaScript-->
    <script src="https://code.jquery.com/jquery-3.3.1.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/js/bootstrap.bundle.min.js" integrity="sha384-pjaaA8dDz/5BgdFUPX6M/9SUZv4d12SUPF0axWc+VRZkx5xU3daN+lYb49+Ax+Tl" crossorigin="anonymous"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/javascripts/sb-admin.min.js"></script>

  </body>

</html>
